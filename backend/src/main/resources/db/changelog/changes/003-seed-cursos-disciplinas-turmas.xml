  <changeSet id="003-seed-cursos" author="desafio-matriculas" context="seed">
    <comment>5 cursos da area de tecnologia</comment>
    <loadData
      tableName="curso"
      file="db/changelog/data/cursos-seed.csv"
      separator=","
      encoding="UTF-8">
      <column name="codigo" type="STRING"/>
      <column name="nome" type="STRING"/>
      <column name="carga_horaria" type="NUMERIC"/>
      <column name="ativo" type="BOOLEAN"/>
    </loadData>
  </changeSet>

